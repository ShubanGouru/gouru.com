---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, BUY_BOX, MARKETS } from "../consts";

/**
 * The site serves two audiences who want opposite things. The page splits them
 * high — immediately under the hero — rather than making either one read copy
 * written for the other.
 */
const steps = [
  {
    number: "01",
    title: "Acquire",
    body: "We buy directly from owners and brokers. No listing process, no staging, no repairs asked of the seller before closing.",
  },
  {
    number: "02",
    title: "Improve",
    body: "Unit turns, deferred maintenance, and the capital projects that small portfolios tend to defer one more year.",
  },
  {
    number: "03",
    title: "Operate",
    body: "Disciplined management, rents brought to market, real expense control. We run the asset, then hold or sell once the plan is done.",
  },
];
---

<Base title="Home" description={SITE.description}>
  <!-- Hero -->
  <section class="wrap pt-16 pb-14 md:pt-24 md:pb-20">
    <p class="eyebrow reveal">{SITE.brandName}</p>
    <h1
      class="display reveal mt-6 max-w-4xl text-[clamp(2.75rem,6vw+1rem,5.5rem)]"
      style="animation-delay:60ms"
    >
      {SITE.tagline}
    </h1>
    <p class="lead reveal mt-7 max-w-2xl" style="animation-delay:120ms">
      Gouru Capital Partners acquires, improves, and operates 5&ndash;40 unit
      apartment communities. Our current focus is in North Carolina.
    </p>
    <div class="reveal mt-9 flex flex-wrap gap-3" style="animation-delay:180ms">
      <a href="/sell/" class="btn btn-primary">Sell us your property</a>
      <a href="/invest/" class="btn btn-ghost">Invest with us</a>
    </div>
  </section>

  <!-- The two-audience split -->
  <section class="wrap py-6 md:py-10">
    <div class="grid gap-5 md:grid-cols-2">
      <a
        href="/sell/"
        class="card group flex flex-col justify-between transition-colors hover:border-navy-500 md:p-8"
      >
        <div>
          <p class="eyebrow">For owners &amp; brokers</p>
          <h2 class="display mt-5 text-2xl md:text-3xl">
            You have a property to sell.
          </h2>
          <p class="mt-4 text-body">
            Turnover you are tired of chasing, maintenance you would rather not
            fund, a partner who wants out, or simply a good time to be done. We
            buy direct, work around tenants in place, and close on your timeline.
          </p>
        </div>
        <p class="mt-7 font-medium text-navy">
          Sell to us <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">&rarr;</span>
        </p>
      </a>

      <a
        href="/invest/"
        class="card group flex flex-col justify-between transition-colors hover:border-navy-500 md:p-8"
      >
        <div>
          <p class="eyebrow">For capital partners</p>
          <h2 class="display mt-5 text-2xl md:text-3xl">
            You have capital to put to work.
          </h2>
          <p class="mt-4 text-body">
            We bring partners into deals we source, underwrite, and operate
            ourselves. You see the specific property and the business plan
            before you commit to anything. There is no blind pool.
          </p>
        </div>
        <p class="mt-7 font-medium text-navy">
          Invest with us <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">&rarr;</span>
        </p>
      </a>
    </div>
  </section>

  <!-- What we do -->
  <section class="wrap py-16 md:py-24">
    <p class="eyebrow">What we do</p>
    <h2 class="display mt-6 max-w-2xl text-3xl md:text-[2.75rem]">
      Buy well, fix what was ignored, run it properly.
    </h2>
    <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        steps.map((step) => (
          <div>
            <p class="font-display text-3xl text-navy-500">{step.number}</p>
            <h3 class="mt-3 text-xl font-medium">{step.title}</h3>
            <p class="mt-3 text-body">{step.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Criteria summary -->
  <section class="wrap py-4">
    <div class="rounded-3xl bg-navy px-6 py-12 text-paper md:px-12 md:py-16">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow !text-[#8fb0d4]">What we buy</p>
          <h2 class="display mt-5 text-3xl text-paper md:text-4xl">
            Our criteria, in the open.
          </h2>
        </div>
        <a href="/sell/" class="btn btn-ghost !border-white/25 !text-paper hover:!border-paper">
          See the full buy box
        </a>
      </div>

      <dl class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          BUY_BOX.map((item) => (
            <div class="border-t border-white/15 pt-5">
              <dt class="text-xs font-medium uppercase tracking-[0.18em] text-[#8fb0d4]">
                {item.label}
              </dt>
              <dd class="mt-2 text-xl font-medium text-paper">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Markets -->
  <section class="wrap py-16 md:py-24">
    <p class="eyebrow">Where we buy</p>
    <h2 class="display mt-6 max-w-2xl text-3xl md:text-[2.75rem]">
      Rooted in North Carolina. Open across the country.
    </h2>
    <ul class="mt-12 space-y-px">
      {
        MARKETS.map((market) => (
          <li class="grid gap-2 border-t border-line py-6 md:grid-cols-[10rem_1fr_1.2fr] md:gap-8">
            <p class="text-xs font-medium uppercase tracking-[0.18em] text-navy-500">
              {market.tier}
            </p>
            <p class="text-lg font-medium text-navy">{market.region}</p>
            <p class="text-body">{market.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand
    heading="Have a property, or want to see deals?"
    body="Tell us which one and we will take it from there. Most conversations start with a five-minute call."
    primaryLabel="Get in touch"
  />
</Base>
