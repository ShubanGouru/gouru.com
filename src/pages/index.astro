---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, MARKETS } from "../consts";

/**
 * The buy box deliberately does NOT appear here. It lives on /sell/, where
 * someone is actually deciding whether to send us a deal. Repeating the same
 * four criteria on every page makes a broker stop reading them.
 */
const steps = [
  {
    number: "01",
    title: "Acquire",
    body: "We buy directly from owners and brokers. No listing process, no staging, and no repairs asked of the seller before closing.",
  },
  {
    number: "02",
    title: "Improve",
    body: "Unit turns, deferred maintenance, and the capital projects that small portfolios tend to defer one more year.",
  },
  {
    number: "03",
    title: "Operate",
    body: "Disciplined management, rents brought to market, real expense control. We run the asset, then hold or sell once the plan is done.",
  },
];
---

<Base
  title={`${SITE.brandName} — We buy small multifamily`}
  rawTitle
  description={SITE.description}
>
  <!-- Hero -->
  <section class="wrap border-b border-line pt-16 pb-16 md:pt-20 md:pb-20">
    <p class="eyebrow reveal">{SITE.brandName}</p>
    <h1
      class="display reveal mt-7 text-[clamp(2.75rem,6.5vw,5.25rem)]"
      style="animation-delay:60ms"
    >
      We buy <em>small multifamily.</em>
    </h1>
    <p
      class="lead reveal mt-8 max-w-[43rem]"
      style="animation-delay:120ms"
    >
      We acquire, improve, and operate 5&ndash;40 unit apartment communities.
      Our current focus is in North Carolina, though we will go further for the
      right deal.
    </p>
    <div class="reveal mt-10 flex flex-wrap gap-3.5" style="animation-delay:180ms">
      <a href="/sell/" class="btn btn-primary">Sell us your property</a>
      <a href="/invest/" class="btn btn-ghost">Invest with us</a>
    </div>
  </section>

  <!-- The two audiences -->
  <section class="wrap border-b border-line py-14 md:py-16">
    <div class="grid gap-12 md:grid-cols-2 md:gap-14">
      <div>
        <p class="eyebrow">I. For owners &amp; brokers</p>
        <h2 class="display mt-4 text-[clamp(1.75rem,2vw+1rem,2.125rem)]">
          You have a property to sell.
        </h2>
        <p class="mt-4 text-body">
          Turnover you are tired of chasing, maintenance you would rather not
          fund, a partner who wants out, or simply a good time to be done. We
          buy direct, work around tenants in place, and close on your timeline.
        </p>
        <a href="/sell/" class="btn btn-outline mt-7">Sell to us</a>
      </div>

      <div class="md:border-l md:border-line md:pl-14">
        <p class="eyebrow">II. For capital partners</p>
        <h2 class="display mt-4 text-[clamp(1.75rem,2vw+1rem,2.125rem)]">
          You have capital to put to work.
        </h2>
        <p class="mt-4 text-body">
          We bring partners into deals we source, underwrite, and operate
          ourselves. You see the specific property and the business plan before
          you commit to anything. There is no blind pool.
        </p>
        <a href="/invest/" class="btn btn-outline mt-7">Invest with us</a>
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="wrap border-b border-line py-14 md:py-20">
    <p class="eyebrow eyebrow-muted">What we do</p>
    <h2 class="display mt-6 max-w-2xl text-[clamp(1.9rem,2.6vw+1rem,2.75rem)]">
      Buy well, fix what was ignored, run it properly.
    </h2>
    <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-10">
      {
        steps.map((step) => (
          <div>
            <p class="ui text-sm font-medium tracking-[0.16em] text-accent">
              {step.number}
            </p>
            <h3 class="display mt-3 text-2xl">{step.title}</h3>
            <p class="mt-3 text-body">{step.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Where we buy -->
  <section class="wrap py-14 md:py-20">
    <p class="eyebrow eyebrow-muted">Where we buy</p>
    <ul class="schedule mt-8">
      {
        MARKETS.map((market) => (
          <li class="grid gap-x-8 gap-y-1 py-5 md:grid-cols-[10rem_16rem_1fr]">
            <p class="ui text-xs font-medium uppercase tracking-[0.2em] text-accent md:pt-2">
              {market.tier}
            </p>
            <p class="text-[1.35rem] text-ink">{market.region}</p>
            <p class="text-body md:pt-1">{market.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand
    heading="Have a property, or want to see deals?"
    body="Tell us which one and we will take it from there. Most conversations start with a five-minute call."
  />
</Base>
