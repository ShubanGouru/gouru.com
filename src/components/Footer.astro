---
import { NAV, LEGAL_NAV, SITE } from "../consts";

// Copyright year is resolved once at build time.
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-navy text-paper md:mt-32">
  <div class="wrap py-14 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr] md:gap-8">
      <!-- Brand -->
      <div class="max-w-xs">
        <div class="flex items-center gap-2.5">
          <img
            src="/mark-light.png"
            alt=""
            width="30"
            height="30"
            class="h-7 w-7"
            loading="lazy"
            decoding="async"
          />
          <span class="text-lg font-medium tracking-tight text-paper">{SITE.name}</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-[#a9b6c7]">
          {SITE.tagline} Built by {SITE.legalName}.
        </p>
      </div>

      <!-- Sitemap -->
      <nav aria-label="Footer">
        <h2 class="text-xs font-medium uppercase tracking-[0.18em] text-[#8497ad]">
          Company
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[#cdd7e3] transition-colors hover:text-paper"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Legal + contact -->
      <div>
        <h2 class="text-xs font-medium uppercase tracking-[0.18em] text-[#8497ad]">
          Legal
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            LEGAL_NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[#cdd7e3] transition-colors hover:text-paper"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="text-[#cdd7e3] transition-colors hover:text-paper"
            >
              {SITE.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <hr class="my-10 border-0 border-t border-white/10" />

    <div
      class="flex flex-col gap-3 text-sm text-[#9aa8bb] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.legalName}. All rights reserved.</p>
      <p class="flex items-center gap-4">
        <a
          href={`mailto:${SITE.email}`}
          class="transition-colors hover:text-paper"
        >
          {SITE.email}
        </a>
        <span aria-hidden="true" class="text-white/20">/</span>
        <span>{SITE.domain}</span>
      </p>
    </div>
  </div>
</footer>
