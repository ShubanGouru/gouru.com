---
import { NAV, LEGAL_NAV, SITE } from "../consts";

const year = new Date().getFullYear();
---

<footer class="mt-24 bg-ink text-paper md:mt-32">
  <div class="wrap py-14 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr] md:gap-8">
      <div class="max-w-sm">
        <div class="flex items-center gap-3">
          <img
            src="/mark-light.png"
            alt=""
            width="30"
            height="30"
            class="h-7 w-7"
            loading="lazy"
            decoding="async"
          />
          <span class="text-[1.65rem] leading-none tracking-[0.02em] text-paper">
            {SITE.name}
          </span>
        </div>
        <p class="mt-5 leading-relaxed text-[#b3a996]">
          {SITE.brandName} buys, improves, and operates small multifamily
          properties. Our current focus is North Carolina.
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="ui text-xs font-medium uppercase tracking-[0.2em] text-[#8c826f]">
          Company
        </h2>
        <ul class="ui mt-5 space-y-3 text-sm">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[#ddd4c2] transition-colors hover:text-paper"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="ui text-xs font-medium uppercase tracking-[0.2em] text-[#8c826f]">
          Reach us
        </h2>
        <ul class="ui mt-5 space-y-3 text-sm">
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="text-[#ddd4c2] transition-colors hover:text-paper"
            >
              {SITE.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${SITE.phone}`}
              class="text-[#ddd4c2] transition-colors hover:text-paper"
            >
              {SITE.phoneDisplay}
            </a>
          </li>
          {
            LEGAL_NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[#8c826f] transition-colors hover:text-paper"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="my-10 border-0 border-t border-white/10" />

    <div
      class="ui flex flex-col gap-3 text-sm text-[#8c826f] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.legalName}. All rights reserved.</p>
      <p>{SITE.domain}</p>
    </div>
  </div>
</footer>
