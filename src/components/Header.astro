---
import { NAV, SITE } from "../consts";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

// "Home" is reachable through the wordmark, so it is not repeated in the bar.
const links = NAV.filter((item) => item.href !== "/");
---

<header class="border-b-2 border-ink">
  <div class="wrap flex items-center justify-between gap-4 py-5 md:py-6">
    <a
      href="/"
      class="flex items-center gap-3"
      aria-label={`${SITE.brandName} — home`}
    >
      <img
        src="/mark.png"
        alt=""
        width="30"
        height="30"
        class="h-7 w-7"
        loading="eager"
        decoding="async"
      />
      <span class="text-[1.65rem] leading-none tracking-[0.02em] text-ink">
        {SITE.name}
      </span>
    </a>

    <div class="flex items-center gap-8">
      <nav class="hidden md:block" aria-label="Primary">
        <ul class="ui flex items-center gap-6 text-sm lg:gap-8">
          {
            links.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "inline-block py-1 transition-colors hover:text-accent",
                    isActive(item.href) ? "text-ink" : "text-body",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Sellers reach for the phone before the form. */}
      <a
        href={`tel:${SITE.phone}`}
        class="ui hidden border-b-2 border-accent pb-0.5 text-sm font-medium text-ink lg:inline-block"
      >
        {SITE.phoneDisplay}
      </a>

      <button
        type="button"
        class="-mr-2 inline-flex items-center justify-center p-2 text-ink md:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Menu</span>
        <svg
          class="icon-open h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3.5 7h17M3.5 12h17M3.5 17h17"></path>
        </svg>
        <svg
          class="icon-close h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="border-t border-line md:hidden"
    aria-label="Primary"
    hidden
  >
    <ul class="wrap ui flex flex-col py-2">
      {
        links.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "block border-b border-line py-3.5 text-base transition-colors hover:text-accent",
                isActive(item.href) ? "text-ink" : "text-body",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={`tel:${SITE.phone}`}
          class="block py-3.5 text-base font-medium text-accent"
        >
          {SITE.phoneDisplay}
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  /*
    The button's own aria-expanded state drives which icon shows, so the ARIA
    attribute and the visual can never disagree.
  */
  [data-menu-toggle][aria-expanded="false"] .icon-close,
  [data-menu-toggle][aria-expanded="true"] .icon-open {
    display: none;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-nav");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    /*
      Crossing into the desktop layout leaves the menu open behind a CSS
      display:none. Reset it so returning to a narrow viewport does not reveal
      a panel the visitor never opened.
    */
    const desktop = window.matchMedia("(min-width: 768px)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
