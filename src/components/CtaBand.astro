---
import { SITE } from "../consts";

interface Props {
  heading?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  /** Omit both secondary props to render a single button. */
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  heading = "Let's talk.",
  body = "Whether you have a property to sell or capital to put to work, the first step is the same: a short conversation.",
  primaryHref = "/contact/",
  primaryLabel = "Get in touch",
  secondaryHref = `tel:${SITE.phone}`,
  secondaryLabel = SITE.phoneDisplay,
} = Astro.props;
---

<section class="wrap">
  <div
    class="rounded-3xl border border-line bg-paper-deep px-6 py-12 text-center md:px-12 md:py-16"
  >
    <h2 class="display text-3xl md:text-4xl">{heading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-body">{body}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
      {
        secondaryHref && secondaryLabel && (
          <a href={secondaryHref} class="btn btn-ghost">
            {secondaryLabel}
          </a>
        )
      }
    </div>
  </div>
</section>
